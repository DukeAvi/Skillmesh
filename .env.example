# Copy to .env and adjust if you changed docker-compose.yml or the credentials.
# Every value has a working default in scripts/config.py, so .env is optional.

PG_DSN=postgresql://skillmesh:skillmesh@localhost:5432/skillmesh

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=skillmesh123

REDIS_HOST=localhost
# Host port; the Redis container still listens on 6379 internally.
REDIS_PORT=6380

# Optional knobs
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
PRESENCE_TTL=60

# Optional one-time first-admin setup code. Set a unique random value of at
# least 16 characters before starting the web service; remove it after setup.
# SKILLMESH_SETUP_CODE=
