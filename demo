                    JOIN users teacher ON teacher.user_id = r.provider_id
                    JOIN skills s ON s.skill_id = r.skill_id
                    WHERE r.request_id = %s
                    """,
                    (request_id,),
                )
                print_table([column.name for column in cur.description], cur.fetchall())

    print("\nWalkthrough data was committed for inspection.")
    print("Run './demo cleanup' before repeating it or starting the formal demo.")


def add_user(args) -> None:
    """Add a teaching or learning skill and rank users on the opposite side."""
    heading("Add a user skill and find a match")
    print("Starting PostgreSQL if needed...")
    run("docker", "compose", "up", "-d", "--wait", "postgres")

    from scripts.config import pg_connect
    from scripts.embeddings import embed, embedding_literal
    from scripts.seed_postgres import build_text, seed_embeddings

    name = prompt_value("Full name", args.name, required=True)
    email = prompt_value("Email", args.email, required=True).lower()
    if "@" not in email or email.startswith("@") or email.endswith("@"):
        raise UserInputError("Email must look like name@example.com")
    password_hash = prompt_value(
        "Password hash (authentication is not implemented)",
        args.password_hash,
        default="manual-cli-placeholder-hash",
        required=True,
    )
    role = prompt_choice(
        "Role", args.role, ("student", "mentor", "admin"), "student"
    )
    skill_type = args.skill_type or ("TEACH" if role == "mentor" else "LEARN")
    if args.create_request and skill_type == "TEACH":
        raise UserInputError(
            "--create-request is only valid for LEARN entries because learners "
            "initiate swap requests"
        )
    print(
        f"Skill mode: {skill_type} "
        f"({'mentor default' if role == 'mentor' else 'account default'}; "
        f"override with --skill-type if needed)."
    )
    department = prompt_value("Department (optional)", args.department)
    year_of_study = prompt_year(args.year_of_study)
    bio = prompt_value("Bio (optional)", args.bio)

    conn = pg_connect()
    try:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT s.skill_id, s.name,
                       COUNT(us.user_skill_id) FILTER (
                           WHERE us.skill_type = 'TEACH'
                       ) AS teachers,
                       COUNT(us.user_skill_id) FILTER (
                           WHERE us.skill_type = 'LEARN'
                       ) AS learners
                FROM skills s
                LEFT JOIN user_skills us ON us.skill_id = s.skill_id
                GROUP BY s.skill_id, s.name
                ORDER BY s.name
                """
            )
            available_skills = cur.fetchall()

        if not available_skills:
            raise UserInputError(
                "No skills exist in the catalogue; seed the database before adding a user skill"
            )

        if args.skill is None:
            print("\nAvailable skills (enter a skill ID or its exact name):")
            print_table(("skill_id", "skill", "teachers", "learners"), available_skills)
        action_word = "teach" if skill_type == "TEACH" else "learn"
        requested_skill = prompt_value(
            f"Skill to {action_word}", args.skill, required=True
        )

        selected_skill = None
        for skill_id, skill_name, teacher_count, learner_count in available_skills:
            if requested_skill.casefold() == skill_name.casefold() or (
                requested_skill.isdigit() and int(requested_skill) == skill_id
            ):
                selected_skill = (
                    skill_id,
                    skill_name,
                    teacher_count,
                    learner_count,
                )
                break
        if selected_skill is None:
            raise UserInputError(
                f"Unknown skill {requested_skill!r}; choose an ID or name from the catalogue"
            )

        skill_id, skill_name, teacher_count, learner_count = selected_skill
        proficiency = prompt_choice(
            "Current proficiency",
            args.proficiency,
            ("beginner", "intermediate", "advanced"),
            "beginner",
        )
        description = prompt_value(
            "What can you teach?" if skill_type == "TEACH" else "What do you want to learn?",
            args.description,
            default=(
                f"I can teach {skill_name}."
                if skill_type == "TEACH"
                else f"I want to learn {skill_name}."
            ),
            required=True,
        )

        print("\nGenerating the skill embedding and filling any missing embeddings...")
        skill_embedding = embedding_literal(
            embed(build_text(skill_name, description))
        )

        with conn.transaction():
            with conn.cursor() as cur:
                cur.execute("SELECT user_id FROM users WHERE email = %s", (email,))
                existing = cur.fetchone()
                cur.execute(
                    """
                    INSERT INTO users (
                        name, email, password_hash, role, department,
                        year_of_study, bio
                    )
                    VALUES (%s, %s, %s, %s, %s, %s, %s)
                    ON CONFLICT (email) DO UPDATE SET
                        name = EXCLUDED.name,
                        password_hash = EXCLUDED.password_hash,
                        role = EXCLUDED.role,
                        department = EXCLUDED.department,
                        year_of_study = EXCLUDED.year_of_study,
                        bio = EXCLUDED.bio
                    RETURNING user_id
                    """,
                    (
                        name,
                        email,
                        password_hash,
                        role,
                        department or None,
                        year_of_study,
                        bio or None,
                    ),
                )
                user_id = cur.fetchone()[0]
                cur.execute(
                    """
                    INSERT INTO user_skills (
                        user_id, skill_id, skill_type, proficiency_level,
                        description, embedding
                    )
                    VALUES (%s, %s, %s, %s, %s, %s::vector)
                    ON CONFLICT (user_id, skill_id, skill_type) DO UPDATE SET
                        proficiency_level = EXCLUDED.proficiency_level,
                        description = EXCLUDED.description,
                        embedding = EXCLUDED.embedding
                    """,
                    (
                        user_id,
                        skill_id,
                        skill_type,
                        proficiency,
                        description,
                        skill_embedding,
                    ),
                )

            # A fresh Docker volume has seeded rows with NULL vectors. Fill them
            # here so this one command is sufficient for either match direction.
            seed_embeddings(conn=conn)

            with conn.cursor() as cur:
                counterpart_type = "TEACH" if skill_type == "LEARN" else "LEARN"
                cur.execute(
                    """
                    WITH source AS (
                        SELECT embedding
                        FROM user_skills
                        WHERE user_id = %s
                          AND skill_id = %s
                          AND skill_type = %s
                    )
                    SELECT candidate.user_id, u.name, candidate.skill_id,
                           s.name,
                           1 - (candidate.embedding <=> source.embedding) AS similarity
                    FROM source
                    CROSS JOIN user_skills candidate
                    JOIN users u ON u.user_id = candidate.user_id
                    JOIN skills s ON s.skill_id = candidate.skill_id
                    WHERE candidate.skill_type = %s
                      AND candidate.user_id <> %s
                      AND candidate.embedding IS NOT NULL
                    ORDER BY candidate.embedding <=> source.embedding,
                             candidate.user_skill_id
                    LIMIT %s
                    """,
                    (
                        user_id,
                        skill_id,
                        skill_type,
                        counterpart_type,
                        user_id,
                        args.limit,
                    ),
                )
                matches = cur.fetchall()
                cur.execute(
                    """
                    WITH source AS (
                        SELECT embedding
                        FROM user_skills
                        WHERE user_id = %s
                          AND skill_id = %s
                          AND skill_type = %s
                    )
                    SELECT candidate.user_id, u.name, candidate.skill_id,
                           s.name,
                           1 - (candidate.embedding <=> source.embedding) AS similarity
                    FROM source
                    CROSS JOIN user_skills candidate
                    JOIN users u ON u.user_id = candidate.user_id
                    JOIN skills s ON s.skill_id = candidate.skill_id
                    WHERE candidate.skill_type = %s
                      AND candidate.skill_id = %s
                      AND candidate.user_id <> %s
                      AND candidate.embedding IS NOT NULL
                    ORDER BY candidate.embedding <=> source.embedding,
                             candidate.user_skill_id
                    """,
                    (
                        user_id,
                        skill_id,
                        skill_type,
                        counterpart_type,
                        skill_id,
                        user_id,
                    ),
                )
                exact_matches = cur.fetchall()
                request_id = None
                if args.create_request:
                    if not exact_matches:
                        raise UserInputError(
                            f"No exact {skill_name} teacher is available; "
                            "a request was not created"
                        )
                    chosen = exact_matches[0]
                    cur.execute(
                        "CALL sp_create_swap_request(%s::BIGINT, %s::BIGINT, "
                        "%s::BIGINT, %s::REAL, NULL::BIGINT)",
                        (user_id, chosen[0], skill_id, float(chosen[4])),
                    )
                    request_id = cur.fetchone()[0]

        action = "Updated" if existing else "Created"
        counterpart_label = "teacher" if skill_type == "LEARN" else "learner"
        exact_count = teacher_count if skill_type == "LEARN" else learner_count
        print(f"\n{action} user {name} (user_id={user_id}).")
        print(
            f"Saved {skill_type} {'goal' if skill_type == 'LEARN' else 'offering'}: "
            f"{skill_name} ({proficiency}); catalogue has {exact_count} exact "
            f"{counterpart_label}(s)."
        )
        if matches:
            display_matches = [
                (
                    rank,
                    row[0],
                    row[1],
                    row[3],
                    "yes" if row[2] == skill_id else "no",
                    f"{float(row[4]):.4f}",
                )
                for rank, row in enumerate(matches, 1)
            ]
            print(f"\nRanked semantic {counterpart_label} matches:")
            print_table(
                (
                    "#",
                    "user_id",
                    counterpart_label,
                    "matched skill",
                    "exact",
                    "similarity",
                ),
                display_matches,
            )
        else:
            print(
                f"\nNo {counterpart_label}s with embeddings are currently available."
            )

        if request_id is not None:
            print(f"\nCreated pending swap_request {request_id} for {exact_matches[0][1]}.")
        elif exact_matches:
            message = (
                "\nBest exact match: "
                f"{exact_matches[0][1]} (user_id={exact_matches[0][0]})."
            )
            if skill_type == "LEARN":
                message += " Next: run ./demo create-request."
            print(message)
    finally:
        conn.close()


def _select_skill(rows, requested, prompt_label):
    """Select a skill row by numeric ID or case-insensitive exact name."""
    value = prompt_value(prompt_label, requested, required=True)
    for row in rows:
        skill_id, skill_name = row[:2]
        if value.casefold() == skill_name.casefold() or (
            value.isdigit() and int(value) == skill_id
        ):
            return row
    raise UserInputError(
        f"Unknown skill {value!r}; choose an ID or name from the displayed list"
    )


def _learner_and_skill(conn, user_arg, skill_arg):
    """Resolve an existing learner and one of their LEARN skills."""
    with conn.cursor() as cur:
        cur.execute(
            """
            SELECT u.user_id, u.name, u.email, COUNT(*) AS learn_skills
            FROM users u
            JOIN user_skills us ON us.user_id = u.user_id
            WHERE us.skill_type = 'LEARN'
            GROUP BY u.user_id, u.name, u.email
            ORDER BY u.name, u.user_id
            """
        )
        learners = cur.fetchall()
    if not learners:
        raise UserInputError(
            "No users have LEARN skills; run ./demo add-user first"
        )

    if user_arg is None:
        print("\nLearners available for matching:")
        print_table(("user_id", "name", "email", "LEARN skills"), learners)
    selector = prompt_value(
        "Learner name, user ID, or email", user_arg, required=True
    )
    selected_users = [
        row
        for row in learners
        if selector == str(row[0])
        or selector.casefold() == row[1].casefold()
        or selector.casefold() == row[2].casefold()
    ]
    if not selected_users:
        raise UserInputError(
            f"No learner matching {selector!r}; choose from the displayed list"
        )
    if len(selected_users) > 1:
        raise UserInputError(
            f"More than one learner is named {selector!r}; select by user ID or email"
        )

    user_id, user_name, email, _ = selected_users[0]
    with conn.cursor() as cur:
        cur.execute(
            """
            SELECT s.skill_id, s.name, us.proficiency_level, us.description
            FROM user_skills us
            JOIN skills s ON s.skill_id = us.skill_id
            WHERE us.user_id = %s
              AND us.skill_type = 'LEARN'
            ORDER BY s.name
            """,
            (user_id,),
        )
        skill_rows = cur.fetchall()
    if skill_arg is None:
        print(f"\nLEARN skills for {user_name}:")
        print_table(
            ("skill_id", "skill", "proficiency", "description"), skill_rows
        )
    selected = _select_skill(skill_rows, skill_arg, "Skill to match")
    return email, user_id, user_name, selected[0], selected[1]


def _rank_teachers(conn, learner_id, skill_id, limit):
    """Return semantic results plus every exact-skill teacher."""
    with conn.cursor() as cur:
        cur.execute(
            """
            SELECT provider_id, provider_name, matched_skill_id,
                   matched_skill, similarity
            FROM fn_find_skill_matches(%s::BIGINT, %s::BIGINT, %s)
            """,
            (learner_id, skill_id, limit),
        )
        matches = cur.fetchall()
        cur.execute(
            """
            WITH learner AS (
                SELECT embedding
                FROM user_skills
                WHERE user_id = %s
                  AND skill_id = %s
                  AND skill_type = 'LEARN'
            )
            SELECT teacher.user_id, u.name, u.email,
                   1 - (teacher.embedding <=> learner.embedding) AS similarity
            FROM learner
            CROSS JOIN user_skills teacher
            JOIN users u ON u.user_id = teacher.user_id
            WHERE teacher.skill_type = 'TEACH'
              AND teacher.skill_id = %s
              AND teacher.user_id <> %s
              AND teacher.embedding IS NOT NULL
            ORDER BY teacher.embedding <=> learner.embedding,
                     teacher.user_skill_id
            """,
            (learner_id, skill_id, skill_id, learner_id),
        )
        exact_teachers = cur.fetchall()
    return matches, exact_teachers


def _print_teacher_matches(matches, requested_skill_id):
    """Render semantic teacher matches with exact-skill markers."""
    if not matches:
        print("\nNo teachers with embeddings are currently available.")
        return
    display_rows = [
        (
            rank,
            row[0],
            row[1],
            row[3],
            "yes" if row[2] == requested_skill_id else "no",
            f"{float(row[4]):.4f}",
        )
        for rank, row in enumerate(matches, 1)
    ]
    print("\nRanked semantic teacher matches:")
    print_table(
        ("#", "user_id", "teacher", "matched skill", "exact", "similarity"),
        display_rows,
    )


def find_match(args) -> None:
    """Find teachers for an existing user's LEARN skill without writing a request."""
    heading("Find a teacher for an existing learner")
    run("docker", "compose", "up", "-d", "--wait", "postgres")

    from scripts.config import pg_connect
    from scripts.seed_postgres import seed_embeddings

    conn = pg_connect()
    try:
        email, learner_id, learner_name, skill_id, skill_name = _learner_and_skill(
            conn, args.user, args.skill
        )
        seed_embeddings(conn=conn)
        matches, exact_teachers = _rank_teachers(
            conn, learner_id, skill_id, args.limit
        )
        print(
            f"\nLearner: {learner_name} ({email}, user_id={learner_id})\n"
            f"Requested skill: {skill_name} (skill_id={skill_id})"
        )
        _print_teacher_matches(matches, skill_id)
        if exact_teachers:
            best = exact_teachers[0]
            print(
                f"\nBest exact teacher: {best[1]} "
                f"(user_id={best[0]}, similarity={float(best[3]):.4f})."
            )
            print("Next: run ./demo create-request")
        else:
            print(f"\nNo teacher currently offers the exact skill {skill_name}.")
    finally:
        conn.close()


def create_request(args) -> None:
    """Create a pending request from an existing learner to an exact teacher."""
    heading("Create a pending skill-swap request")
    run("docker", "compose", "up", "-d", "--wait", "postgres")

    from scripts.config import pg_connect
    from scripts.seed_postgres import seed_embeddings

    conn = pg_connect()
    try:
        email, learner_id, learner_name, skill_id, skill_name = _learner_and_skill(
            conn, args.learner, args.skill
        )
        seed_embeddings(conn=conn)
        _, exact_teachers = _rank_teachers(conn, learner_id, skill_id, 50)
        if not exact_teachers:
            raise UserInputError(f"No teacher currently offers {skill_name}")

        teacher_rows = [
            (row[0], row[1], row[2], f"{float(row[3]):.4f}")
            for row in exact_teachers
        ]
        if args.provider is None:
            print(f"\nExact {skill_name} teachers:")
            print_table(("user_id", "teacher", "email", "similarity"), teacher_rows)
        provider_value = prompt_value(
            "Teacher user ID or email",
            args.provider,
            default=str(exact_teachers[0][0]),
            required=True,
        )
        chosen = None
        for row in exact_teachers:
            if provider_value == str(row[0]) or provider_value.casefold() == row[2].casefold():
                chosen = row
                break
        if chosen is None:
            raise UserInputError(
                f"Teacher {provider_value!r} does not offer the exact skill {skill_name}"
            )

        with conn.transaction():
            with conn.cursor() as cur:
                cur.execute(
                    """
                    SELECT request_id
                    FROM swap_requests
                    WHERE requester_id = %s
                      AND provider_id = %s
                      AND skill_id = %s
                      AND status = 'pending'
                    ORDER BY request_id DESC
                    LIMIT 1
                    """,
                    (learner_id, chosen[0], skill_id),
                )
                existing = cur.fetchone()
                if existing:
                    request_id = existing[0]
                    created = False
                else:
                    cur.execute(
                        "CALL sp_create_swap_request(%s::BIGINT, %s::BIGINT, "
                        "%s::BIGINT, %s::REAL, NULL::BIGINT)",
                        (learner_id, chosen[0], skill_id, float(chosen[3])),
                    )
                    request_id = cur.fetchone()[0]
                    created = True

        action = "Created" if created else "Reused existing"
        print(
            f"\n{action} pending request {request_id}: "
            f"{learner_name} -> {chosen[1]} for {skill_name} "
            f"(similarity={float(chosen[3]):.4f})."
        )
        print("Next: the teacher can run ./demo accept-request")
    finally:
        conn.close()


def accept_request(args) -> None:
    """Accept a pending request after selecting its provider."""
    heading("Accept an incoming skill-swap request")
    run("docker", "compose", "up", "-d", "--wait", "postgres")

    from scripts.config import pg_connect

    conn = pg_connect()
    try:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT provider.user_id, provider.name, provider.email,
                       COUNT(*) AS pending_requests
                FROM swap_requests r
                JOIN users provider ON provider.user_id = r.provider_id
                WHERE r.status = 'pending'
                GROUP BY provider.user_id, provider.name, provider.email
                ORDER BY provider.name, provider.user_id
                """
            )
            providers = cur.fetchall()
        if not providers:
            raise UserInputError("No teachers currently have pending requests")
        if args.provider is None:
            print("\nTeachers with pending incoming requests:")
            print_table(
                ("user_id", "teacher", "email", "pending requests"), providers
            )
        selector = prompt_value(
            "Teacher name, user ID, or email", args.provider, required=True
        )
        selected_providers = [
            row
            for row in providers
            if selector == str(row[0])
            or selector.casefold() == row[1].casefold()
            or selector.casefold() == row[2].casefold()
        ]
        if not selected_providers:
            raise UserInputError(
                f"No teacher matching {selector!r} has a pending request"
            )
        if len(selected_providers) > 1:
            raise UserInputError(
                f"More than one teacher is named {selector!r}; "
                "select by user ID or email"
            )
        provider_id, provider_name, provider_email, _ = selected_providers[0]

        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT r.request_id, learner.name, learner.email,
                       s.name, round(r.similarity_score::numeric, 4), r.status
                FROM swap_requests r
                JOIN users learner ON learner.user_id = r.requester_id
                JOIN skills s ON s.skill_id = r.skill_id
                WHERE r.provider_id = %s
                  AND r.status = 'pending'
                ORDER BY r.request_id
                """,
                (provider_id,),
            )
            pending = cur.fetchall()
        if args.request_id is None:
            print(f"\nPending incoming requests for {provider_name}:")
            print_table(
                ("request_id", "learner", "email", "skill", "similarity", "status"),
                pending,
            )
        request_value = prompt_value(
            "Request ID",
            args.request_id,
            default=str(pending[0][0]),
            required=True,
        )
        if not request_value.isdigit():
            raise UserInputError("Request ID must be a number")
        request_id = int(request_value)
        if request_id not in {row[0] for row in pending}:
            raise UserInputError(
                f"Request {request_id} is not pending for {provider_email!r}"
            )

        with conn.transaction():
            with conn.cursor() as cur:
                cur.execute(
                    """
                    UPDATE swap_requests r
                    SET status = 'accepted'
                    WHERE r.request_id = %s
                      AND r.provider_id = %s
                      AND r.status = 'pending'
                    RETURNING r.requester_id, r.provider_id, r.skill_id
                    """,
                    (request_id, provider_id),
                )
                accepted = cur.fetchone()
                if accepted is None:
                    raise UserInputError(
                        f"Request {request_id} could not be accepted"
                    )
                cur.execute(
                    """
                    SELECT learner.name, provider.name, s.name
                    FROM users learner
                    CROSS JOIN users provider
                    CROSS JOIN skills s
                    WHERE learner.user_id = %s
                      AND provider.user_id = %s
                      AND s.skill_id = %s
                    """,
                    accepted,
                )
                learner_name, provider_name, skill_name = cur.fetchone()

        print(
            f"\nAccepted request {request_id}: {provider_name} will teach "
            f"{skill_name} to {learner_name}."
        )
    finally:
        conn.close()


