def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        description="Run the SkillMesh viva without copying long SQL commands."
    )
    subparsers = parser.add_subparsers(dest="demo", required=True)
    commands = {
        "prepare": "start containers and fill missing embeddings",
        "cleanup": "remove only data created by the CLI walkthrough",
        "app": "create a user, skills, vector match, and swap request",
        "add-user": "add a teaching or learning skill and find matches",
        "find-match": "find teachers for an existing learner",
        "create-request": "create a pending request for an exact teacher",
        "accept-request": "accept a provider's pending incoming request",
        "postgres": "routines, function calls, procedure calls, and view",
        "race": "two learners competing for one slot",
        "match": "vector matching plus the HNSW index",
        "presence": "Redis heartbeat and TTL cycle",
        "graph": "Neo4j sync and graph queries",
        "tests": "the complete integration suite",
        "all": "the full live demo, including the CLI app journey",
    }
    custom_commands = {
        "add-user",
        "find-match",
        "create-request",
        "accept-request",
    }
    for name, help_text in commands.items():
        if name in custom_commands:
            continue
        subparsers.add_parser(name, help=help_text)

    add_user_parser = subparsers.add_parser(
        "add-user",
        help=commands["add-user"],
        description=(
            "Create or update a user and TEACH/LEARN skill, generate embeddings, "
            "and rank users on the opposite side. Mentors default to TEACH; "
            "other roles default to LEARN. Omitted fields are prompted for."
        ),
    )
    add_user_parser.add_argument("--name", help="user's full name")
    add_user_parser.add_argument("--email", help="unique user email")
    add_user_parser.add_argument(
        "--password-hash",
        help="placeholder hash (this project does not implement authentication)",
    )
    add_user_parser.add_argument(
        "--role", choices=("student", "mentor", "admin"), help="account role"
    )
    add_user_parser.add_argument("--department", help="department name")
    add_user_parser.add_argument(
        "--year-of-study", type=int, choices=range(1, 7), help="year from 1 to 6"
    )
    add_user_parser.add_argument("--bio", help="short user biography")
    add_user_parser.add_argument(
        "--skill-type",
        choices=("LEARN", "TEACH"),
        help="skill direction (default: TEACH for mentors, otherwise LEARN)",
    )
    add_user_parser.add_argument("--skill", help="skill ID or exact skill name")
    add_user_parser.add_argument(
        "--proficiency",
        choices=("beginner", "intermediate", "advanced"),
        help="current proficiency in the selected skill",
    )
    add_user_parser.add_argument(
        "--description", help="specific teaching offering or learning goal"
    )
    add_user_parser.add_argument(
        "--limit", type=match_limit, default=5, help="matches to show (1-50)"
    )
    add_user_parser.add_argument(
        "--create-request",
        action="store_true",
        help="create a pending request for the best exact-skill teacher",
    )

    find_match_parser = subparsers.add_parser(
        "find-match",
        help=commands["find-match"],
        description=(
            "Rank teachers for an existing user's LEARN skill without creating "
            "a request. Omitted identity and skill fields are prompted for."
        ),
    )
    find_match_parser.add_argument(
        "--user",
        "--email",
        dest="user",
        help="learner user ID, name, or email",
    )
    find_match_parser.add_argument("--skill", help="LEARN skill ID or exact name")
    find_match_parser.add_argument(
        "--limit", type=match_limit, default=5, help="matches to show (1-50)"
    )

    create_request_parser = subparsers.add_parser(
        "create-request",
        help=commands["create-request"],
        description=(
            "Create a pending request from an existing learner to a teacher who "
            "offers the exact requested skill."
        ),
    )
    create_request_parser.add_argument(
        "--learner",
        "--learner-email",
        dest="learner",
        help="learner user ID, name, or email",
    )
    create_request_parser.add_argument(
        "--skill", help="learner's LEARN skill ID or exact name"
    )
    create_request_parser.add_argument(
        "--provider", help="teacher user ID or email (defaults to the best match)"
    )

    accept_request_parser = subparsers.add_parser(
        "accept-request",
        help=commands["accept-request"],
        description=(
            "List and accept a teacher's pending incoming request. Select the "
            "teacher by user ID, name, or email."
        ),
    )
    accept_request_parser.add_argument(
        "--provider",
        "--provider-email",
        dest="provider",
        help="teacher user ID, name, or email",
    )
    accept_request_parser.add_argument(
        "--request-id", type=int, help="pending request ID"
    )
    args = parser.parse_args(argv)

    actions = {
        "prepare": prepare,
        "cleanup": cleanup,
        "app": app_demo,
        "add-user": lambda: add_user(args),
        "find-match": lambda: find_match(args),
        "create-request": lambda: create_request(args),
        "accept-request": lambda: accept_request(args),
        "postgres": postgres_demo,
        "race": lambda: run(PYTHON, "scripts/concurrency_test.py"),
        "match": match_demo,
        "presence": lambda: run(PYTHON, "scripts/redis_presence.py"),
        "graph": lambda: run(PYTHON, "scripts/neo4j_sync.py", "--demo-queries"),
        "tests": lambda: run(PYTHON, "-m", "pytest", "tests/", "-v"),
        "all": all_demo,
    }
    try:
        actions[args.demo]()
    except (OSError, subprocess.CalledProcessError, UserInputError) as exc:
        print(f"Demo failed: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
