    from scripts.embeddings import embed, embedding_literal

    # Make the walkthrough repeatable without resetting Docker volumes.
    cleanup(verbose=False)

    heading("CLI app walkthrough: user -> skills -> match -> request")
    with pg_connect() as conn:
        with conn.transaction():
            with conn.cursor() as cur:
                print("[1/5] Creating a student account")
                cur.execute(
                    """
                    INSERT INTO users
                        (name, email, password_hash, role, department, year_of_study, bio)
                    VALUES
                        (%s, %s, %s, 'student', 'Information Systems', 2, %s)
                    RETURNING user_id, name, email, role
                    """,
                    (
                        "Avrit Sharma",
                        DEMO_EMAIL,
                        "demo-only-placeholder-hash",
                        "Created live during the SkillMesh viva walkthrough.",
                    ),
                )
                user_row = cur.fetchone()
                user_id = user_row[0]
                print_table([column.name for column in cur.description], [user_row])

                print("\n[2/5] Adding a new skill to the catalogue")
                cur.execute(
                    """
                    INSERT INTO skills (category_id, name, description)
                    VALUES (
                        (SELECT category_id FROM skill_categories WHERE name = 'Languages'),
                        %s,
                        'Presenting ideas clearly to an audience with confident delivery.'
                    )
                    RETURNING skill_id, name, description
                    """,
                    (DEMO_SKILL,),
                )
                new_skill_row = cur.fetchone()
                public_speaking_id = new_skill_row[0]
                print_table([column.name for column in cur.description], [new_skill_row])

                cur.execute("SELECT skill_id FROM skills WHERE name = 'Guitar'")
                guitar_id = cur.fetchone()[0]

                print("\n[3/5] Registering one TEACH skill and one LEARN skill")
                skill_rows = [
                    (
                        public_speaking_id,
                        "TEACH",
                        "advanced",
                        "I teach public speaking, presentation structure and confident delivery.",
                    ),
                    (
                        guitar_id,
                        "LEARN",
                        "beginner",
                        "I want to learn guitar chords, strumming and beginner fingerpicking.",
                    ),
                ]
                for skill_id, skill_type, proficiency, description in skill_rows:
                    cur.execute(
                        """
                        INSERT INTO user_skills
                            (user_id, skill_id, skill_type, proficiency_level,
                             description, embedding)
                        VALUES (%s, %s, %s, %s, %s, %s::vector)
                        """,
                        (
                            user_id,
                            skill_id,
                            skill_type,
                            proficiency,
                            description,
                            embedding_literal(embed(description)),
                        ),
                    )
                cur.execute(
                    """
                    SELECT s.name AS skill, us.skill_type, us.proficiency_level,
                           vector_dims(us.embedding) AS dimensions
                    FROM user_skills us
                    JOIN skills s ON s.skill_id = us.skill_id
                    WHERE us.user_id = %s
                    ORDER BY us.skill_type DESC
                    """,
                    (user_id,),
                )
                print_table([column.name for column in cur.description], cur.fetchall())

                print("\n[4/5] Finding teachers with the vector-match function")
                cur.execute(
                    """
                    SELECT provider_id, provider_name, matched_skill_id,
                           matched_skill, round(similarity::numeric, 4) AS similarity
                    FROM fn_find_skill_matches(%s::BIGINT, %s::BIGINT, 5)
                    """,
                    (user_id, guitar_id),
                )
                matches = cur.fetchall()
                match_columns = [column.name for column in cur.description]
                print_table(match_columns, matches)
                exact_matches = [row for row in matches if row[2] == guitar_id]
                if not exact_matches:
                    raise RuntimeError("no Guitar teacher was returned by the match function")
                chosen = exact_matches[0]

                print("\n[5/5] Sending the chosen teacher a validated request")
                cur.execute(
                    "CALL sp_create_swap_request(%s::BIGINT, %s::BIGINT, %s::BIGINT, "
                    "%s::REAL, NULL::BIGINT)",
