def cleanup(verbose: bool = True) -> None:
    """Remove only rows created by ``app_demo``; preserve all seed data."""
    from scripts.config import neo4j_driver, pg_connect, redis_client

    user_id = None
    with pg_connect() as conn:
        with conn.transaction():
            with conn.cursor() as cur:
                cur.execute("SELECT user_id FROM users WHERE email = %s", (DEMO_EMAIL,))
                row = cur.fetchone()
                user_id = row[0] if row else None
                cur.execute("DELETE FROM users WHERE email = %s", (DEMO_EMAIL,))
                deleted_users = cur.rowcount
                cur.execute("DELETE FROM skills WHERE name = %s", (DEMO_SKILL,))
                deleted_skills = cur.rowcount

    # The graph is a derived read model and Redis is ephemeral, so cleanup is
    # best-effort when either optional service is not currently available.
    try:
        driver = neo4j_driver()
        try:
            with driver.session() as session:
                session.run(
                    "MATCH (u:User {email: $email}) DETACH DELETE u",
                    email=DEMO_EMAIL,
                ).consume()
                session.run(
                    "MATCH (s:Skill {name: $name}) DETACH DELETE s",
                    name=DEMO_SKILL,
                ).consume()
        finally:
            driver.close()
        graph_status = "clean"
    except Exception as exc:
        graph_status = f"skipped ({type(exc).__name__}: service unavailable)"

    try:
        client = redis_client()
        try:
            if user_id is not None:
                client.delete(f"online:{user_id}")
        finally:
            client.close()
        redis_status = "clean"
    except Exception as exc:
        redis_status = f"skipped ({type(exc).__name__}: service unavailable)"

    if verbose:
        heading("Demo cleanup")
        print(f"PostgreSQL demo users removed : {deleted_users}")
        print(f"PostgreSQL demo skills removed: {deleted_skills}")
        print(f"Neo4j projection              : {graph_status}")
        print(f"Redis presence                : {redis_status}")
        print("Seeded users, skills, sessions, and feedback were preserved.")


def app_demo() -> None:
