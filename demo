def show_procedures() -> None:
    from scripts.config import pg_connect

    section("3. Transactional procedures")
    conn = pg_connect()
    try:
        with conn.cursor() as cur:
            cur.execute("BEGIN")
            cur.execute(
                "CALL sp_create_swap_request(%s::BIGINT, %s::BIGINT, %s::BIGINT, "
                "%s::REAL, NULL::BIGINT)",
                (1, 4, 5, 0.95),
            )
            request_id = cur.fetchone()[0]
            cur.execute(
                """
                SELECT request_id, requester_id, provider_id, skill_id, status
                FROM swap_requests WHERE request_id = %s
                """,
                (request_id,),
            )
            print("Create request:")
            print_table([column.name for column in cur.description], cur.fetchall())

            cur.execute(
                "UPDATE swap_sessions SET status = 'scheduled', completed_at = NULL "
                "WHERE session_id = 1"
            )
            cur.execute("CALL sp_complete_swap_session(1::BIGINT)")
            cur.execute(
                """
                SELECT session_id, status,
                       completed_at IS NOT NULL AS has_completion_time
                FROM swap_sessions WHERE session_id = 1
                """
            )
            print("\nComplete session:")
            print_table([column.name for column in cur.description], cur.fetchall())
    finally:
        with conn.cursor() as cur:
            cur.execute("ROLLBACK")
        conn.close()
    print("\nDemo transaction rolled back; seeded data is unchanged.")


