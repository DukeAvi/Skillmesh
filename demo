def heading(title: str) -> None:
    print(f"\n{'=' * 68}\n{title}\n{'=' * 68}", flush=True)


def section(title: str) -> None:
    """Print a lightweight section label for compact command output."""
    print(f"\n{title}", flush=True)


def run(*command: str) -> None:
    sys.stdout.flush()
    subprocess.run(command, cwd=ROOT, check=True)


def query_rows(sql: str, params=()):
    from scripts.config import pg_connect

    with pg_connect() as conn:
        with conn.cursor() as cur:
            cur.execute(sql, params)
            columns = [column.name for column in cur.description]
            return columns, cur.fetchall()


def print_table(columns, rows) -> None:
    text_rows = [[str(value) for value in row] for row in rows]
    widths = [len(column) for column in columns]
    for row in text_rows:
        widths = [max(width, len(value)) for width, value in zip(widths, row)]

    def line(values):
        return " | ".join(value.ljust(width) for value, width in zip(values, widths))

    print(line(columns))
    print("-+-".join("-" * width for width in widths))
    for row in text_rows:
        print(line(row))


class UserInputError(ValueError):
    """Raised when the interactive add-user command receives invalid input."""


def prompt_value(label: str, supplied=None, *, default=None, required=False) -> str:
    """Return a CLI value, prompting only when the corresponding flag was omitted."""
    if supplied is not None:
        value = str(supplied).strip()
        if value or not required:
            return value

    suffix = f" [{default}]" if default is not None else ""
    while True:
        try:
            value = input(f"{label}{suffix}: ").strip()
        except EOFError as exc:
            raise UserInputError(
                f"{label} is required; pass it as a command-line option"
            ) from exc
        if value:
            return value
        if default is not None:
            return str(default)
        if not required:
            return ""
        print(f"{label} cannot be empty.")


def prompt_choice(label: str, supplied, choices, default: str) -> str:
    """Prompt until one of the allowed case-insensitive values is entered."""
    if supplied is not None:
        return supplied
    allowed = {choice.lower(): choice for choice in choices}
    while True:
        value = prompt_value(
            f"{label} ({'/'.join(choices)})", default=default, required=True
        ).lower()
        if value in allowed:
            return allowed[value]
        print(f"Choose one of: {', '.join(choices)}.")


def prompt_year(supplied=None):
    """Read an optional year of study and enforce the database's 1..6 constraint."""
    if supplied is not None:
        return supplied
    while True:
        value = prompt_value("Year of study (1-6, optional)")
        if not value:
            return None
        try:
            year = int(value)
        except ValueError:
            print("Year of study must be a number from 1 to 6.")
            continue
        if 1 <= year <= 6:
            return year
        print("Year of study must be between 1 and 6.")


def match_limit(value: str) -> int:
    """Argparse converter for the match function's supported result range."""
    try:
        limit = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a number from 1 to 50") from exc
    if not 1 <= limit <= 50:
        raise argparse.ArgumentTypeError("must be between 1 and 50")
    return limit


