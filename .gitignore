# ---------------------------------------------------------------------------
# Local-only documentation
# ---------------------------------------------------------------------------
# Personal/working documentation - kept out of the repository on purpose.
playbook.md
arch_overview.md
docs/engineering.md
docs/phone.png

# ---------------------------------------------------------------------------
# Python virtual environment
# ---------------------------------------------------------------------------
# Recreated locally with:  python3 -m venv .venv
# Installs PyTorch + sentence-transformers, so it is ~1 GB. Never commit it.
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Local secrets
# ---------------------------------------------------------------------------
# Real credentials go here; .env.example (the tracked template) does not.
.env
.env.local
.env.*.local
!.env.example

# ---------------------------------------------------------------------------
# Python bytecode / build artefacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Test / type-check / lint caches
# ---------------------------------------------------------------------------
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ---------------------------------------------------------------------------
# Hugging Face / sentence-transformers model cache
# ---------------------------------------------------------------------------
# Default location is ~/.cache/huggingface, but a project-local one may appear
# if HF_HOME is pointed here. ~80 MB per model.
hf_cache/
models/
.cache/huggingface/

