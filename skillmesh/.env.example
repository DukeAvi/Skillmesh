# Copy to .env and adjust if you changed docker-compose.yml or the credentials.
# Every value has a working default in scripts/config.py, so .env is optional.

PG_DSN=postgresql://skillmesh:skillmesh@localhost:5432/skillmesh

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=skillmesh123

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional knobs
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
PRESENCE_TTL=60