# Synthetic demo only. Source from the repository root with `set -a` enabled.
# These names and ports keep the demo separate from the default Compose project.
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=skillmesh-portfolio
POSTGRES_PORT=15432
REDIS_PORT=16380
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
WEB_PORT=18080
PG_DSN=postgresql://skillmesh:skillmesh@127.0.0.1:15432/skillmesh
REDIS_HOST=127.0.0.1
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASS=skillmesh123
# Used by the optional host Python server; Docker uses port 8080 internally.
SKILLMESH_WEB_PORT=18081
